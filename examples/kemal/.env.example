# =============================================================================
# .env.example — Variables d'environnement (projet Kemal)
# =============================================================================

# ─── Clé secrète ──────────────────────────────────────────────────────────────
# [généré]
SECRET_KEY=

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# [db] Construite par le dialogue crystal-deploy (DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost/mon_app_development
# [test]
DATABASE_URL_TEST=postgresql://user:password@localhost/mon_app_test

# ─── SMTP (optionnel) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

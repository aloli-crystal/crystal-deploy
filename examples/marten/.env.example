# =============================================================================
# .env.example — Variables d'environnement (projet Marten)
# Copiez ce fichier en .env et adaptez les valeurs pour le développement local.
# Ne versionnez JAMAIS .env
#
# Convention crystal-deploy :
#   [auto]       injectée depuis config/deploy.yml — jamais demandée
#   [db]         construite par le dialogue base de données
#   [test]       ignorée au déploiement
#   [généré]     générée automatiquement si vide
# =============================================================================

# ─── Environnement ────────────────────────────────────────────────────────────
# [auto]
MARTEN_ENV=development

# ─── Clé secrète ──────────────────────────────────────────────────────────────
# [généré] Générer avec :
#   crystal eval 'require "random/secure"; puts Random::Secure.hex(64)'
SECRET_KEY=

# ─── Serveur ──────────────────────────────────────────────────────────────────
# [auto] Dev local uniquement
APP_HOST=127.0.0.1
# [auto] Dev local uniquement
PORT=3000
# [auto] Injecté depuis config/deploy.yml en production
MARTEN_ALLOWED_HOSTS=mon-app.example.app
# [auto] Injecté depuis config/deploy.yml en production
MARTEN_SOCKET=

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# [db] Construites par le dialogue crystal-deploy
DB_HOST=localhost
DB_PORT=5432
DB_USER=mon_app
DB_PASSWORD=
DB_NAME=mon_app_development
# [test] Ignorée au déploiement
DB_NAME_TEST=mon_app_test
# Taille du pool de connexions
DB_POOL_SIZE=10

# ─── SMTP (optionnel) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# ─── Stripe (optionnel) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
